# Copy to .env and set your own local values; never commit .env.
DATABASE_URL=postgresql+psycopg://expense:expense@localhost:5432/expense_tracker
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
